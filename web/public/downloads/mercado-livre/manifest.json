{
  "manifest_version": 3,
  "name": "Disparei — Mercado Livre",
  "version": "0.2.0",
  "description": "Conecta o Mercado Livre à Disparei, importa o catálogo e gera links de afiliado.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["https://*.mercadolivre.com.br/*", "https://meli.la/*", "https://*.disparei.pro/*"],
  "background": { "service_worker": "dist/service-worker.js", "type": "module" },
  "action": { "default_popup": "popup/index.html", "default_title": "Disparei — Mercado Livre" },
  "content_scripts": [
    { "matches": ["https://*.disparei.pro/*"], "js": ["dist/disparei-bridge.js"], "run_at": "document_start" },
    { "matches": ["https://*.mercadolivre.com.br/*"], "exclude_matches": ["https://*.mercadolivre.com.br/afiliados/linkbuilder*"], "js": ["dist/catalog-capture.js"], "run_at": "document_idle" },
    { "matches": ["https://*.mercadolivre.com.br/afiliados/linkbuilder*"], "js": ["dist/mercado-livre-bridge.js"], "run_at": "document_idle" }
  ]
}
